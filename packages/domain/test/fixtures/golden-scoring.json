{
  "version": 1,
  "description": "Shared scoring oracle. Every expectation here is written from the published marking scheme, NOT generated from either implementation. The TypeScript engine (packages/domain) and the PL/pgSQL functions (packages/db) are both asserted against this file. If they disagree with it, they are wrong -- the fixture is not updated to match an implementation.",
  "optionIds": {
    "note": "Option identity is a stable id, never a letter or an index. Letters here are shorthand for readability only.",
    "A": "opt-a",
    "B": "opt-b",
    "C": "opt-c",
    "D": "opt-d"
  },
  "markingRules": {
    "MAIN_MCQ": {
      "questionType": "MCQ_SINGLE",
      "correct": 4,
      "incorrect": -1,
      "unattempted": 0
    },
    "MAIN_NUMERIC": {
      "questionType": "NUMERIC_INTEGER",
      "correct": 4,
      "incorrect": -1,
      "unattempted": 0,
      "numeric": { "kind": "EXACT_INTEGER" },
      "penaliseUnparseable": true
    },
    "ADV_MULTI": {
      "questionType": "MCQ_MULTI",
      "correct": 4,
      "incorrect": -1,
      "unattempted": 0,
      "partial": {
        "mode": "LADDER_BY_CORRECT_SELECTED",
        "awardIfAllCorrectSelected": 4,
        "awardBySelectedCorrectCount": { "1": 1, "2": 2, "3": 3 },
        "penaltyIfAnyIncorrect": -1
      }
    },
    "ALL_OR_NOTHING_MULTI": {
      "questionType": "MCQ_MULTI",
      "correct": 4,
      "incorrect": -1,
      "unattempted": 0,
      "partial": { "mode": "ALL_OR_NOTHING" }
    },
    "ADV_NUMERIC_2DP_TRUNCATE": {
      "questionType": "NUMERIC_DECIMAL",
      "correct": 4,
      "incorrect": 0,
      "unattempted": 0,
      "numeric": { "kind": "ROUNDED", "decimals": 2, "mode": "TRUNCATE" },
      "penaliseUnparseable": false
    },
    "NUMERIC_2DP_HALFUP": {
      "questionType": "NUMERIC_DECIMAL",
      "correct": 4,
      "incorrect": 0,
      "unattempted": 0,
      "numeric": { "kind": "ROUNDED", "decimals": 2, "mode": "HALF_UP" },
      "penaliseUnparseable": false
    },
    "NUMERIC_TOLERANCE": {
      "questionType": "NUMERIC_DECIMAL",
      "correct": 4,
      "incorrect": -1,
      "unattempted": 0,
      "numeric": { "kind": "TOLERANCE", "toleranceAbs": "0.01" },
      "penaliseUnparseable": true
    }
  },
