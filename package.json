{
  "name": "jee-neet-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant assessment platform for Indian JEE and NEET aspirants",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint:sql": "node scripts/lint-sql.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm lint:sql"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
